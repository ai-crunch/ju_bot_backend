# =====================================================================
# JU Bot — local/dev environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# For production use the repo-root `.env.production.example` instead.
# Do NOT commit a filled-in `.env`.
# =====================================================================

# ---- OpenAI (required) ----------------------------------------------
OPENAI_API_KEY=

# ---- Qdrant ---------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=ju_bot_vdb

# ---- MongoDB --------------------------------------------------------
# Credentials the Mongo container is initialised with on first start.
# Changing them later requires wiping the volume. Use strong values.
MONGO_HOST=localhost
MONGO_PORT=27077
MONGO_ROOT_USERNAME=change-me
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=ju_bot

# ---- Seeded admin user (used by seed_admin.py) ----------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---- Docker build & dev toggles -------------------------------------
# Enable BuildKit (required for the Dockerfile cache mounts that speed up rebuilds).
# Docker 23+ enables BuildKit by default; set explicitly for older clients.
DOCKER_BUILDKIT=1
# Use Bake for parallel multi-service builds with `docker compose build`.
COMPOSE_BAKE=true
# Set to true to run the backend with uvicorn --reload (dev hot-reload via the source bind mount).
UVICORN_RELOAD=false

# ---- Production-only (see .env.production.example) -------------------
# Browser-side base URL the Next.js app uses to reach the backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated origins allowed by FastAPI CORS (empty => "*" for local dev).
# CORS_ALLOWED_ORIGINS=
# Optional Hugging Face token for gated embedding/reranker models.
# HF_TOKEN=
